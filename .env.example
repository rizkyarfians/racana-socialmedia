# Node.js 24 LTS. Copy this file to .env; never commit real values.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/instagram.sqlite
# Random secret used only for Meta webhook verification handshake.
WEBHOOK_VERIFY_TOKEN=
# App secret for the Meta app signing your Instagram webhook payloads.
META_APP_SECRET=
# Set to the supported Graph API version shown in your Meta app, e.g. vXX.0.
META_GRAPH_VERSION=
# Instagram professional account ID (NOT username, Page ID or app ID).
IG_ACCOUNT_ID=
# Instagram Login user token with instagram_business_basic and
# instagram_business_manage_messages. Test token is manually provisioned.
IG_ACCESS_TOKEN=
# Sender IGSID from a verified inbound test message. Only this sender can be replied to.
TEST_RECIPIENT_ID=
